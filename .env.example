PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/testdb
NODE_ENV=development

# Comma-separated list of allowed frontend origins (CORS + refresh Origin check)
FRONTEND_URL=http://localhost:5173

# Access / refresh token signing secrets (use long random values in production)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# One-time bootstrap admin (used only by scripts/seedAdmin.js)
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
ADMIN_EMAIL=admin@example.com
ADMIN_MOBILE=+910000000000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
